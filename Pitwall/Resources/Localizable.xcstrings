    "Inloggen via je iPhone, iPad of Mac": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with your iPhone, iPad or Mac"
          }
        }
      }
    },
    "Installeer Pitwall op je iPhone, iPad of Mac en log daar in met F1 TV.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Pitwall on your iPhone, iPad or Mac and sign in with F1 TV there."
          }
        }
      }
    },
    "Instellingen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings"
          }
        }
      }
    },
    "Internationaal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "International"
          }
        }
      }
    },
    "Je Apple TV is ingelogd.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV is signed in."
          }
        }
      }
    },
    "Je Apple TV logt in met je Pitwall-account en krijgt meteen je F1 TV-login, instellingen en setups.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple TV signs in with your Pitwall account and immediately gets your F1 TV sign-in, settings and setups."
          }
        }
      }
    },
    "Je F1 TV-sessie is verlopen. Log opnieuw in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your F1 TV session has expired. Please sign in again."
          }
        }
      }
    },
    "Je Pitwall-account verwijderen? Dit kan niet ongedaan worden gemaakt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete your Pitwall account? This can't be undone."
          }
        }
      }
    },
    "Je account kan op maximaal %lld apparaten tegelijk worden gebruikt. Verwijder een apparaat om op dit apparaat in te loggen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account can be used on up to %lld devices. Remove a device to sign in on this one."
          }
        }
      }
    },
    "Je bent niet ingelogd.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're not signed in."
          }
        }
      }
    },
    "Je e-mailadres is bevestigd. Je kunt nu inloggen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your email address is confirmed. You can sign in now."
          }
        }
      }
    },
    "Je logt in op de officiële F1-pagina. Pitwall bewaart alleen de sessie, nooit je wachtwoord.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You sign in on the official F1 page. Pitwall only keeps the session, never your password."
          }
        }
      }
    },
    "Je logt in op de officiële F1-pagina. Pitwall slaat alleen de sessie op in je sleutelhanger, nooit je wachtwoord.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You sign in on the official F1 page. Pitwall only keeps the session in your keychain, never your password."
          }
        }
      }
    },
    "Kies deze Apple TV en vul de code in.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose this Apple TV and enter the code."
          }
        }
      }
    },
