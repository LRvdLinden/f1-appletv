      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        }
      }
    },
    "Bewaart de geopende feeds en de indeling, zodat je ze bij een volgende sessie in één keer opent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the open feeds and layout so you can open them in one go next session."
          }
        }
      }
    },
