    "Commentaar in je taal wordt gekozen als F1 TV het voor die sessie aanbiedt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commentary in your language is picked when F1 TV offers it for that session."
