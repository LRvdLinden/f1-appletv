{
  "sourceLanguage": "nl",
  "version": "1.0",
  "strings": {
    "%@ is nu ingelogd.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is now signed in."
          }
        }
      }
    },
    "%@ verwijderen? Het apparaat wordt uitgelogd.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %@? It will be signed out."
          }
        }
      }
    },
    "%lld min geleden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min ago"
          }
        }
      }
    },
    "%lld van %lld apparaten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld of %lld devices"
